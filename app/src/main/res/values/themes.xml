<resources>
    <!--
        Window theme used while the app starts, before Compose draws anything.
        The real app theme is HealthMateTheme in ui/theme/Theme.kt.
        Light only: the spec defines a white, light design.
    -->
    <style name="Theme.HealthMate" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
